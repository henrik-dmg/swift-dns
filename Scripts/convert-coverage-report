#!/usr/bin/env bash

# Converts the coverage data of `swift test --enable-code-coverage` to an lcov file (macOS only).
# Run `swift test --enable-code-coverage` before you run this script.
#
# Usage: Scripts/convert-coverage-report [--output <path>]
#
# Adapted from https://github.com/michaelhenry/swifty-code-coverage/blob/main/lcov.sh

set -euo pipefail

OUTPUT_FILE="coverage/lcov.info"
IGNORE_FILENAME_REGEX=".build|Tests"

while [ $# -gt 0 ]; do
  case $1 in
    --output)
      OUTPUT_FILE=$2
      shift
      ;;
    --target)
      # Not used. SwiftPM gives the test bundle path. The option stays for old calls.
      shift
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
  shift
done

# SwiftPM gives the paths for the active build system. The bundle name and the folder
# are different for the native build system and the Swift Build system of Swift 6.4.
BIN_PATH=$(swift build --show-bin-path)
INSTR_PROFILE="$(dirname "$(swift test --show-codecov-path)")/default.profdata"
XCTEST_BUNDLE=$(find "$BIN_PATH" -maxdepth 1 -name "*.xctest" | head -1)

if [ ! -f "$INSTR_PROFILE" ]; then
  echo "No coverage data at $INSTR_PROFILE. Run swift test --enable-code-coverage first."
  exit 1
fi

if [ -z "$XCTEST_BUNDLE" ]; then
  echo "No .xctest bundle in $BIN_PATH. Run swift test --enable-code-coverage first."
  exit 1
fi

OBJECT_FILE="$XCTEST_BUNDLE/Contents/MacOS/$(basename "$XCTEST_BUNDLE" .xctest)"

mkdir -p "$(dirname "$OUTPUT_FILE")"

# Print the summary to stdout
xcrun llvm-cov report \
  "$OBJECT_FILE" \
  --instr-profile="$INSTR_PROFILE" \
  --ignore-filename-regex="$IGNORE_FILENAME_REGEX"

# Export the coverage data in lcov format
xcrun llvm-cov export \
  "$OBJECT_FILE" \
  --instr-profile="$INSTR_PROFILE" \
  --ignore-filename-regex="$IGNORE_FILENAME_REGEX" \
  --format="lcov" > "$OUTPUT_FILE"
